# ClinicalOS Frontend Environment Variables
# Copy this file to .env.local and fill in the values
# Vite requires VITE_ prefix for client-side env vars

# API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# LLM Configuration (optional - for live AI responses)
VITE_LLM_API_ENDPOINT=https://your-llm-endpoint.example.com/api/v1
VITE_LLM_API_KEY=your_api_key_here
VITE_LLM_MAX_RETRIES=3
VITE_LLM_RETRY_BASE_DELAY=2000

# Auth (disabled for capstone demo)
VITE_AUTH_ENABLED=false

# Demo password gate (set in Vercel env vars to protect deployed demo)
# Leave empty for local dev — the gate is invisible when unset
VITE_DEMO_PASS=

# ─── Feedback → GitHub Issues ──────────────────────────────────
# These are SERVER-SIDE only (used by api/feedback.ts on Vercel).
# They do NOT need a VITE_ prefix — they must NOT be exposed to the browser.
#
# 1. Create a GitHub Fine-Grained PAT at https://github.com/settings/tokens?type=beta
#    Scoped to your repo with permissions:  Issues: Write, Contents: Write
# 2. Add both vars in Vercel → Settings → Environment Variables (Production)
#
GITHUB_TOKEN=ghp_your_fine_grained_pat_here
GITHUB_REPO=john-carroll-sw/capstone-clinical-os
